# Server only. Never commit credentials. Use the Neon connection string with TLS.
DATABASE_URL=
SURVEY_SECRET=
SURVEY_ADMIN_EMAIL=
# scrypt:<32 hex salt>:<128 hex derived key>; never a plaintext password
SURVEY_ADMIN_PASSWORD_HASH=
SURVEY_SITE_URL=http://localhost:3005
# Set 1 only for local synthetic preview without DATABASE_URL
SURVEY_PREVIEW_MODE=0

# Optional exact additional trusted website origins, comma-separated; no wildcard
SURVEY_ALLOWED_ORIGINS=
